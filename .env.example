# ==============================================================================
# AI Receptionist Enterprise - Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
APP_NAME="AI Receptionist Enterprise"
APP_VERSION="1.0.0"

# Backend Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]
API_V1_STR=/api/v1
SECRET_KEY=change-me-in-production-super-secret-key-at-least-32-chars

# PostgreSQL Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_receptionist
# Async SQLAlchemy DB URL:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_receptionist
# Sync DB URL for Alembic:
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_receptionist

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=false

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=receptionist_knowledge_base

# Real-Time Voice Infrastructure (Phase 4)
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
STT_LANGUAGE=en-US
STT_SAMPLE_RATE=16000

TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
TTS_LANGUAGE=en

VOICE_WS_TIMEOUT_SECONDS=60
VOICE_SESSION_TIMEOUT_SECONDS=300
VOICE_MAX_AUDIO_CHUNK_BYTES=262144
VAD_SILENCE_TIMEOUT_MS=1500
VAD_MAX_RECORDING_MS=15000
AUDIO_RETENTION_DAYS=0

# Conversational AI & LangGraph Engine (Phase 5)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.3
OPENAI_MAX_TOKENS=500
LLM_REQUEST_TIMEOUT_SECONDS=15
CONVERSATION_MAX_TURNS=30
CONVERSATION_RETENTION_DAYS=7

# Frontend Configuration
NEXT_PUBLIC_APP_NAME="AI Receptionist Kiosk"
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000/api/v1/ws
NEXT_PUBLIC_KIOSK_DEFAULT_ID=kiosk-building-a-lobby-01
